# =============================================================================
# Local development environment variables. Copy to .env (gitignored) and fill
# in your values. In Jenkins these come from `withCredentials` — see Jenkinsfile.
# =============================================================================

# Which environment config to load (qa | dev | staging).
ENV=qa

# Application user credentials. The defaults below match SauceDemo
# (https://www.saucedemo.com). Replace for your own application.
APP_USERNAME=standard_user
APP_PASSWORD=secret_sauce

# Key used by src/utils/crypto.ts to decrypt secrets if you choose to store
# them encrypted. Generate with: openssl rand -hex 32
CRYPTO_KEY=replace-me-with-a-strong-key

# Optional database connection. If DB_HOST is unset, the `dbClient`
# fixture will refuse to construct and tests that need it will fail fast.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=playwright
# DB_PASSWORD=playwright
# DB_NAME=playwright

# Logger level (error | warn | info | debug).
LOG_LEVEL=info

# Number of test workers (defaults to half of CPU). Override per environment.
# WORKERS=4

# Sharding (only set by docker-compose / Jenkins; leave unset locally).
# SHARD_INDEX=1
# SHARD_TOTAL=4
